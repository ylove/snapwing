{
  "name": "snapwing",
  "private": true,
  "version": "0.0.0",
  "description": "Fix it from here: Slack and Teams to Jira to PR, with an autonomy dial",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --parallel run test",
    "test:contract": "pnpm -r --parallel run test:contract",
    "test:live": "pnpm -r run test:live",
    "test:e2e": "pnpm -r run test:e2e",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint . && pnpm run typecheck",
    "lint:prose": "node scripts/lint-prose.mjs",
    "demo": "tsx packages/pipeline/src/demo/run.ts",
    "demo:state": "tsx packages/pipeline/src/demo/state.ts",
    "state": "tsx packages/app/src/cli/main.ts state",
    "serve": "tsx packages/app/src/cli/main.ts serve",
    "github:bootstrap": "tsx scripts/github-bootstrap.ts",
    "jira:bootstrap": "tsx scripts/jira-bootstrap.ts",
    "slack:bootstrap": "tsx scripts/slack-bootstrap.ts",
    "teams:bootstrap": "tsx scripts/teams-bootstrap.ts",
    "slack:test-users": "tsx scripts/slack-test-users.ts",
    "fixer-image:build": "docker build -f infra/docker/fixer/Dockerfile -t snapwing-fixer:local .",
    "pack:cli": "node scripts/pack-cli.mjs",
    "test:pack": "pnpm --filter @snapwing/app run test:pack",
    "onboard:proof": "tsx scripts/onboard-proof.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
