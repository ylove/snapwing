{
  "name": "@snapwing/pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts, ports, engine, and every pipeline stage. No opinion about chat platforms or clouds.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "schemas",
    "manifests",
    "demo"
  ],
  "scripts": {
    "test": "vitest run test/unit",
    "test:contract": "vitest run test/contract --passWithNoTests",
    "test:live": "vitest run test/live --passWithNoTests",
    "test:e2e": "vitest run test/e2e --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.25.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "kysely": "^0.29.6",
    "msw": "^3.0.1",
    "node-schematron": "^2.1.0",
    "openai": "^7.25.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "slimdom": "4.3.5",
    "xmllint-wasm": "^5.3.0"
  }
}
