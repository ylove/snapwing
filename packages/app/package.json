{
  "name": "@snapwing/app",
  "version": "0.0.0",
  "private": true,
  "description": "Server (API plus worker), Slack, Teams, and alert adapters, providers, the snapwing CLI, and onboarding.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "snapwing": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run test/unit",
    "test:contract": "vitest run test/contract --passWithNoTests",
    "test:live": "vitest run test/live --passWithNoTests",
    "test:e2e": "vitest run test/e2e --passWithNoTests --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@snapwing/capture-client": "workspace:*",
    "@snapwing/pipeline": "workspace:*",
    "slimdom": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "msw": "^3.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
