<?xml version="1.0" encoding="UTF-8"?>
<snapwing xmlns="urn:snapwing:config:v1" version="1">
  <!-- `snapwing serve` reads this file, the workspace map (SNAPWING_MAP, default workspace-context.xml),
       and the secrets named in build/CONTEXT.md 6b; every model provider used below needs its key. -->
  <!-- "local" runs the fixer and pull request tests on this host as the server's user: development only
       (ADR 0017). Wherever real secrets are held, use provider="docker" or a cloud provider. -->
  <runtime provider="local"/>
  <models default-provider="anthropic">
    <model task="triage"       provider="anthropic" name="claude-sonnet-5-5"/>
    <model task="segmentation" provider="anthropic" name="claude-haiku-4-5"/>
    <model task="vision"       provider="openai"    name="gpt-5"/>
    <model task="clarify"      provider="anthropic" name="claude-haiku-4-5"/>
    <model task="scout"        provider="anthropic" name="claude-opus-5-5"/>
    <model task="review"       provider="google"    name="gemini-2.5-pro"/>
  </models>
  <harness fixer="claude-code" review="generic">
    <generic id="aider" command="aider --yes --message-file - --json-result" timeout="PT30M"/>
  </harness>
  <merge max-files="10" max-diff-lines="400" revert-window="PT72H">
    <forbidden path=".github/**"/>
    <forbidden path="infra/**"/>
    <forbidden path="**/pnpm-lock.yaml"/>
    <forbidden path="**/vitest.config.*"/>
  </merge>
  <!-- Jira statuses resolve by category (backlog to To Do or Backlog, in-progress to In Progress,
       in-review to In Review when present, done to Done); name one only when the guess is wrong,
       for example <status logical="backlog" name="Selected for Development"/>. -->
  <!-- A work item's issue joins its parent by an issue link (mode="link", the default) or as a
       sub-task (mode="subtask"; a project with no sub-task type falls back to a link). linkType
       names the link type and defaults to Relates, which every Jira Cloud site has; use another
       only if your site has it, for example <workItems mode="link" linkType="Implements"/>.
       A link type the site lacks leaves the issue unlinked with a comment naming the parent. -->
  <jira/>
</snapwing>
