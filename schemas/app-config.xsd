<?xml version="1.0" encoding="UTF-8"?>
<!--
  Application config, snapwing.config.xml (main 14.3 provider selection, main 14.5 models and harness).
  Secrets never appear here; API keys come from the secrets port.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:snapwing:config:v1"
           xmlns:c="urn:snapwing:config:v1"
           targetNamespace="urn:snapwing:config:v1"
           elementFormDefault="qualified">

  <xs:simpleType name="RuntimeProvider">
    <xs:restriction base="xs:string">
      <xs:enumeration value="local"/>
      <xs:enumeration value="aws"/>
      <xs:enumeration value="gcp"/>
      <xs:enumeration value="docker"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ModelProvider">
    <xs:restriction base="xs:string">
      <xs:enumeration value="anthropic"/>
      <xs:enumeration value="openai"/>
      <xs:enumeration value="google"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ModelTask">
    <xs:restriction base="xs:string">
      <xs:enumeration value="triage"/>
      <xs:enumeration value="segmentation"/>
      <xs:enumeration value="vision"/>
      <xs:enumeration value="clarify"/>
      <xs:enumeration value="scout"/>
      <xs:enumeration value="review"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HarnessAdapter">
    <xs:restriction base="xs:string">
      <xs:enumeration value="claude-code"/>
      <xs:enumeration value="codex"/>
      <xs:enumeration value="gemini"/>
      <xs:enumeration value="generic"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ISO 8601 duration limited to days and a time part, matching util/duration.ts: PT30M, PT1H30M, P1D, PT0.5S. -->
  <xs:simpleType name="Duration">
    <xs:restriction base="xs:string">
      <xs:pattern value="P([0-9]+D(T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Logical Jira lifecycle targets (#268); packages/pipeline/src/jira/statuses.ts. -->
  <xs:simpleType name="JiraLogicalStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="backlog"/>
      <xs:enumeration value="in-progress"/>
      <xs:enumeration value="in-review"/>
      <xs:enumeration value="done"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Temperature">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OnOff">
    <xs:restriction base="xs:token">
      <xs:enumeration value="on"/>
      <xs:enumeration value="off"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonEmptyToken">
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="snapwing">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="runtime">
          <xs:complexType>
            <xs:attribute name="provider" type="RuntimeProvider" use="required"/>
            <xs:attribute name="region" type="NonEmptyToken"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="models">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="model" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="task" type="ModelTask" use="required"/>
                  <xs:attribute name="provider" type="ModelProvider" use="required"/>
                  <xs:attribute name="name" type="NonEmptyToken" use="required"/>
                  <!-- Sampling temperature for this task. Absent: none is sent and the model's default applies
                       (several models reject any other value, #275). -->
                  <xs:attribute name="temperature" type="Temperature" use="optional"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="default-provider" type="ModelProvider" use="required"/>
            <!-- Server-side refusal fallback: a request a model's safety classifiers decline is re-run on the
                 provider's fallback model in the same call, on the models and platforms that support it
                 (Anthropic `fallbacks: "default"`, #281). On unless set to off. -->
            <xs:attribute name="refusal-fallback" type="OnOff" default="on"/>
          </xs:complexType>
          <xs:unique name="OneModelPerTask">
            <xs:selector xpath="c:model"/>
            <xs:field xpath="@task"/>
          </xs:unique>
        </xs:element>
        <xs:element name="harness">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="generic" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="id" type="xs:NCName" use="required"/>
                  <xs:attribute name="command" type="NonEmptyToken" use="required"/>
                  <xs:attribute name="timeout" type="Duration" default="PT30M"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="fixer" type="HarnessAdapter" use="required"/>
            <xs:attribute name="review" type="HarnessAdapter" use="required"/>
            <!-- In a runner container the model proxy pins each role's model, caps one call's max_tokens,
                 and caps the tokens one run spends (#273). Absent: the server's defaults. -->
            <xs:attribute name="fixer-model" type="NonEmptyToken"/>
            <xs:attribute name="review-model" type="NonEmptyToken"/>
            <xs:attribute name="max-tokens" type="xs:positiveInteger"/>
            <xs:attribute name="max-run-tokens" type="xs:positiveInteger"/>
          </xs:complexType>
          <xs:unique name="UniqueGenericId">
            <xs:selector xpath="c:generic"/>
            <xs:field xpath="@id"/>
          </xs:unique>
        </xs:element>
        <!-- Optional merge risk gate (main 11.3). Absent attributes take 10 files, 400 lines, PT72H; no
             <forbidden> children are added to the built-in list (.github, infra, lockfiles,
             test and CI config), which config can never remove. -->
        <xs:element name="merge" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="forbidden" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="path" type="NonEmptyToken" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="max-files" type="xs:positiveInteger" default="10"/>
            <xs:attribute name="max-diff-lines" type="xs:positiveInteger" default="400"/>
            <xs:attribute name="revert-window" type="Duration" default="PT72H"/>
          </xs:complexType>
        </xs:element>
        <!-- Optional Jira settings (main 9.1, #268). Snapwing moves issues to logical targets and maps
             each to the project's status by category: backlog to the first "new" status (Backlog
             when present), in-progress to In Progress (else the first "indeterminate" one), in-review
             to In Review when present (else where in-progress goes), done to Done (else the first
             "done" one). A <status> names the project status for one target instead. -->
        <xs:element name="jira" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="status" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="logical" type="JiraLogicalStatus" use="required"/>
                  <xs:attribute name="name" type="NonEmptyToken" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
          <xs:unique name="OneStatusPerTarget">
            <xs:selector xpath="c:status"/>
            <xs:field xpath="@logical"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
