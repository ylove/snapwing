<?xml version="1.0" encoding="UTF-8"?>
<!--
  Workspace context map, structure only (main 4.2). Cross-references (channel to surface,
  owns to component, override refs) are checked by workspace-context.sch.
  XSD 1.0: libxml2 has no 1.1, so no xs:assert (build/decisions/0010).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:snapwing:workspace:v1"
           xmlns:w="urn:snapwing:workspace:v1"
           targetNamespace="urn:snapwing:workspace:v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- Simple types -->

  <xs:simpleType name="IdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9_-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonEmptyString">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConfidenceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="explicit"/>
      <xs:enumeration value="inferred"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ActorRoleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="engineer"/>
      <xs:enumeration value="reporter"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PlatformType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="slack"/>
      <xs:enumeration value="teams"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LevelNumber">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FixerStartType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="never"/>
      <xs:enumeration value="on-tap"/>
      <xs:enumeration value="immediate"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MergeActorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="human"/>
      <xs:enumeration value="agent"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="GateName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="review-agent"/>
      <xs:enumeration value="ci-green"/>
      <xs:enumeration value="risk-gate"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="GateList">
    <xs:list itemType="GateName"/>
  </xs:simpleType>

  <xs:simpleType name="PriorityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Highest"/>
      <xs:enumeration value="High"/>
      <xs:enumeration value="Medium"/>
      <xs:enumeration value="Low"/>
      <xs:enumeration value="Lowest"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Surfaces -->

  <xs:complexType name="ComponentType">
    <xs:attribute name="id" type="IdType" use="required"/>
    <xs:attribute name="label" type="NonEmptyString" use="required"/>
  </xs:complexType>

  <xs:complexType name="JiraType">
    <xs:attribute name="project" type="NonEmptyString" use="required"/>
    <xs:attribute name="defaultIssueType" type="NonEmptyString" use="required"/>
  </xs:complexType>

  <xs:complexType name="SurfaceType">
    <xs:sequence>
      <xs:element name="repo" type="NonEmptyString"/>
      <xs:element name="jira" type="JiraType"/>
      <xs:element name="components" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="component" type="ComponentType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
        <xs:unique name="componentIdUnique">
          <xs:selector xpath="w:component"/>
          <xs:field xpath="@id"/>
        </xs:unique>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="IdType" use="required"/>
    <xs:attribute name="label" type="NonEmptyString" use="required"/>
  </xs:complexType>

  <!-- Channels and triggers -->

  <xs:complexType name="ChannelTriggerType">
    <xs:attribute name="emoji" type="NonEmptyString" use="required"/>
  </xs:complexType>

  <xs:complexType name="ChannelType">
    <xs:sequence>
      <xs:element name="trigger" type="ChannelTriggerType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="NonEmptyString" use="required"/>
    <xs:attribute name="name" type="NonEmptyString" use="required"/>
    <!-- A surface id, or the literal from-payload; the Schematron checks which. -->
    <xs:attribute name="surface" type="NonEmptyString" use="required"/>
    <xs:attribute name="confidence" type="ConfidenceType" use="optional"/>
    <!-- Absent means slack. A teams channel carries its team's group id; the Schematron checks the pairing. -->
    <xs:attribute name="platform" type="PlatformType" use="optional"/>
    <xs:attribute name="team" type="NonEmptyString" use="optional"/>
  </xs:complexType>

  <xs:complexType name="MessageActionType">
    <xs:attribute name="label" type="NonEmptyString" use="required"/>
  </xs:complexType>

  <xs:complexType name="EmojiTriggerType">
    <xs:attribute name="slack" type="NonEmptyString" use="required"/>
    <xs:attribute name="teams" type="NonEmptyString" use="required"/>
    <xs:attribute name="minReactors" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="DirectMessageType">
    <xs:attribute name="images" type="xs:boolean" use="required"/>
    <xs:attribute name="text" type="xs:boolean" use="required"/>
  </xs:complexType>

  <xs:complexType name="CliTriggerType">
    <xs:attribute name="enabled" type="xs:boolean" use="required"/>
  </xs:complexType>

  <!-- Vocabulary -->

  <xs:complexType name="TermType">
    <xs:simpleContent>
      <xs:extension base="NonEmptyString">
        <xs:attribute name="surface" type="IdType" use="required"/>
        <xs:attribute name="component" type="IdType" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- People -->

  <xs:complexType name="OwnsType">
    <xs:attribute name="surface" type="IdType" use="required"/>
    <xs:attribute name="component" type="IdType" use="optional"/>
    <xs:attribute name="primary" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PersonType">
    <xs:sequence>
      <xs:element name="owns" type="OwnsType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="slackId" type="NonEmptyString" use="optional"/>
    <xs:attribute name="teamsId" type="NonEmptyString" use="optional"/>
    <xs:attribute name="handle" type="NonEmptyString" use="required"/>
    <xs:attribute name="email" type="NonEmptyString" use="optional"/>
    <xs:attribute name="role" type="ActorRoleType" use="required"/>
  </xs:complexType>

  <!-- Policies -->

  <xs:complexType name="AskBackType">
    <xs:attribute name="maxQuestionsPerIncident" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="suppressWhenReportersAtLeast" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="LevelType">
    <xs:attribute name="id" type="LevelNumber" use="required"/>
    <xs:attribute name="name" type="NonEmptyString" use="required"/>
    <xs:attribute name="fixer" type="FixerStartType" use="required"/>
    <xs:attribute name="merge" type="MergeActorType" use="required"/>
    <xs:attribute name="requires" type="GateList" use="optional"/>
  </xs:complexType>

  <xs:complexType name="SurfaceOverrideType">
    <xs:attribute name="ref" type="IdType" use="required"/>
    <xs:attribute name="level" type="LevelNumber" use="required"/>
      <!-- Who changed this level and when (main 4.6); a map handle or an email, and an ISO 8601 time. -->
    <xs:attribute name="changedBy" type="NonEmptyString" use="optional"/>
    <xs:attribute name="changedAt" type="xs:dateTime" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ComponentOverrideType">
    <xs:attribute name="surface" type="IdType" use="required"/>
    <xs:attribute name="ref" type="IdType" use="required"/>
    <xs:attribute name="level" type="LevelNumber" use="required"/>
      <!-- Who changed this level and when (main 4.6); a map handle or an email, and an ISO 8601 time. -->
    <xs:attribute name="changedBy" type="NonEmptyString" use="optional"/>
    <xs:attribute name="changedAt" type="xs:dateTime" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PriorityOverrideType">
    <xs:attribute name="atLeast" type="PriorityType" use="required"/>
    <xs:attribute name="level" type="LevelNumber" use="required"/>
      <!-- Who changed this level and when (main 4.6); a map handle or an email, and an ISO 8601 time. -->
    <xs:attribute name="changedBy" type="NonEmptyString" use="optional"/>
    <xs:attribute name="changedAt" type="xs:dateTime" use="optional"/>
  </xs:complexType>

  <xs:complexType name="AutonomyType">
    <xs:sequence>
      <xs:element name="level" type="LevelType" minOccurs="4" maxOccurs="4"/>
      <xs:element name="overrides" minOccurs="0">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="surface" type="SurfaceOverrideType"/>
            <xs:element name="component" type="ComponentOverrideType"/>
            <xs:element name="priority" type="PriorityOverrideType"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="default" type="LevelNumber" use="required"/>
    <!-- Who changed this level and when (main 4.6); a map handle or an email, and an ISO 8601 time. -->
    <xs:attribute name="changedBy" type="NonEmptyString" use="optional"/>
    <xs:attribute name="changedAt" type="xs:dateTime" use="optional"/>
  </xs:complexType>

  <xs:complexType name="RiskGateType">
    <xs:sequence>
      <xs:element name="forbiddenPath" type="NonEmptyString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="maxFilesTouched" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="maxDiffLines" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <!-- Root -->

  <xs:element name="workspace">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="surfaces">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="surface" type="SurfaceType" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="fallbackSurface" type="xs:string" use="optional"/>
          </xs:complexType>
          <xs:unique name="surfaceIdUnique">
            <xs:selector xpath="w:surface"/>
            <xs:field xpath="@id"/>
          </xs:unique>
        </xs:element>
        <xs:element name="channels">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="channel" type="ChannelType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
          <xs:unique name="channelIdUnique">
            <xs:selector xpath="w:channel"/>
            <xs:field xpath="@id"/>
          </xs:unique>
        </xs:element>
        <xs:element name="triggers">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="messageAction" type="MessageActionType"/>
              <xs:element name="emoji" type="EmojiTriggerType"/>
              <xs:element name="directMessage" type="DirectMessageType"/>
              <xs:element name="cli" type="CliTriggerType"/>
            </xs:choice>
          </xs:complexType>
        </xs:element>
        <xs:element name="vocabulary">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="term" type="TermType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="people">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="person" type="PersonType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
          <xs:unique name="personHandleUnique">
            <xs:selector xpath="w:person"/>
            <xs:field xpath="@handle"/>
          </xs:unique>
          <xs:unique name="personSlackIdUnique">
            <xs:selector xpath="w:person"/>
            <xs:field xpath="@slackId"/>
          </xs:unique>
          <xs:unique name="personTeamsIdUnique">
            <xs:selector xpath="w:person"/>
            <xs:field xpath="@teamsId"/>
          </xs:unique>
        </xs:element>
        <xs:element name="policies">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="askBack" type="AskBackType" minOccurs="0"/>
              <xs:element name="autonomy" type="AutonomyType"/>
              <xs:element name="riskGate" type="RiskGateType" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="org" type="NonEmptyString" use="required"/>
      <xs:attribute name="updated" type="xs:dateTime" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
