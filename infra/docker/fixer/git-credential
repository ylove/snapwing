#!/bin/sh
# Snapwing git credential helper for the fixer image (#266, docs/harness-generic.md sections 7 and 8).
# Git runs it as `git-credential get` and reads `username=` and `password=` lines from stdout. It asks
# the wrapper, over the unix socket in SNAPWING_GIT_CREDENTIAL_SOCKET, which fetches a fresh
# installation token from the fixer API each time, so a run longer than a token's hour keeps working.
# The token goes from curl's stdout to git: never to a file, never into an argv. `store` and `erase`
# are ignored; nothing is cached. Without the socket, or when the wrapper cannot get a token, it
# answers nothing and git fails to authenticate.
[ "$1" = get ] || exit 0
cat > /dev/null
[ -n "$SNAPWING_GIT_CREDENTIAL_SOCKET" ] || exit 0
exec curl -fsS --max-time 60 --unix-socket "$SNAPWING_GIT_CREDENTIAL_SOCKET" http://wrapper/git-credential
