# The build context is the repository root; only these paths enter the image. Nothing else (no
# .env, secrets/, *.pem, node_modules, or .git) is ever sent to the docker daemon.
*
!packages/pipeline/src/**
!infra/docker/fixer/wrapper.ts
!infra/docker/fixer/entrypoint.ts
!infra/docker/fixer/forward.ts
!infra/docker/fixer/relay.ts
!infra/docker/fixer/egress.ts
